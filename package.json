{
  "name": "veritas-research-radar",
  "version": "1.3.0",
  "private": true,
  "description": "Veritas browser extension plus local research job radar.",
  "scripts": {
    "start": "node radar/scripts/server.js",
    "radar:refresh": "node radar/scripts/refresh.js",
    "radar:serve": "node radar/scripts/server.js",
    "radar:import-dol": "node radar/scripts/import-dol-lca.js",
    "radar:import-scouted": "node radar/scripts/import-scouted.js",
    "radar:import-aggregated": "node radar/scripts/import-aggregated.js",
    "radar:enrich": "node radar/scripts/enrich.js",
    "scout:jobs": "scout/.venv/bin/python scout/scout_jobs.py",
    "scout:aggregators": "scout/.venv/bin/python scout/scout_aggregators.py",
    "scout:discover": "scout/.venv/bin/python scout/scout_discover.py",
    "scout:discover:parallel": "bash scout/run-discover-parallel.sh",
    "radar:merge-discovery": "node radar/scripts/merge-discovery.js",
    "radar:websites": "node radar/scripts/fetch-nonprofit-websites.js",
    "radar:digest:local": "node radar/scripts/digest-local.js",
    "radar:fit-audit": "node radar/scripts/fit-audit.js",
    "supabase:verify": "node radar/scripts/verify-supabase-target.js --require-link",
    "supabase:verify:manifest": "node radar/scripts/verify-supabase-target.js",
    "supabase:verify:operation": "node radar/scripts/verify-supabase-target.js --require-link --require-url",
    "test": "node tests/radar.test.js && node tests/supabase-target.test.js && node --test tests/matching.test.js tests/feed-health.test.js tests/browser-matching.test.js",
    "app": "bash radar/scripts/launch.sh",
    "app:install": "bash radar/scripts/install-app.sh",
    "app:icon": "python3 radar/scripts/make-icon.py"
  },
  "engines": {
    "node": "24.x"
  }
}
