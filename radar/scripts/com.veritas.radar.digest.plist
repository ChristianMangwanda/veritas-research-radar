<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily fit-aware digest launch agent.

  Arm it (once radar/scripts/.digest.env is filled in — see run-digest.sh):
    cp radar/scripts/com.veritas.radar.digest.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.veritas.radar.digest.plist
    launchctl kickstart -k gui/$(id -u)/com.veritas.radar.digest   # run once now to test

  Disarm:
    launchctl bootout gui/$(id -u)/com.veritas.radar.digest

  Runs every day at 08:00 local. Logs to /tmp/veritas-radar-digest.log.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.veritas.radar.digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/christianmangwanda/Desktop/veritas-research-radar/radar/scripts/run-digest.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/veritas-radar-digest.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/veritas-radar-digest.log</string>
</dict>
</plist>
