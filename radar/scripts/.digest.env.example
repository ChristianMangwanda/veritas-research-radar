# Copy to radar/scripts/.digest.env (gitignored) and fill in.
# The daily fit digest reads these; none of it is committed.

# Where the push goes. Pick any hard-to-guess string, then subscribe to it in
# the ntfy app (or https://ntfy.sh/<your-topic>) on your phone/desktop.
NTFY_TOPIC=veritas-radar-CHANGE-ME

# Fresh data. Without these the digest reads the local jobs.json snapshot, which
# only updates when you run a local refresh — set them to score the live dataset.
# SUPABASE_URL=https://nawbdsujjysugaisczta.supabase.co
# SUPABASE_SERVICE_KEY=

# Optional tuning.
DIGEST_HOURS=24
DIGEST_MIN_VERDICT=good
DASHBOARD_URL=https://christianmangwanda.github.io/veritas-research-radar/
